  <diagram id="01_Diagrama_Contexto_C4" name="Contexto C4 - GestorTech">
    <mxGraphModel dx="3139" dy="948" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;Diagrama de contexto del sistema (C4, nivel 1)&amp;nbsp;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="1320" x="-60" y="15" as="geometry" />
        </mxCell>
        <mxCell id="sys" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=13;strokeWidth=2;" value="&lt;b&gt;GestorTech&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Aplicación web para talleres de servicio técnico: inventario de repuestos y accesorios, órdenes de reparación con historial de estados, seguimiento público por código e importación de productos asistida por IA (opcional).&lt;/span&gt;" vertex="1">
          <mxGeometry height="260" width="380" x="520" y="340" as="geometry" />
        </mxCell>
        <mxCell id="ia" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;dashed=1;dashPattern=8 4;" value="&lt;b&gt;Proveedor de IA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Sistema externo · opcional]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;API de inferencia (Groq como candidato inicial, OpenRouter como alternativa). Devuelve una propuesta estructurada de datos de producto.&lt;/span&gt;" vertex="1">
          <mxGeometry height="190" width="300" x="1160" y="90" as="geometry" />
        </mxCell>
        <mxCell id="arch" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;" value="&lt;b&gt;Archivos de productos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[CSV / Excel]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Listados de repuestos y accesorios que el negocio recibe de sus proveedores.&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="1170" y="360" as="geometry" />
        </mxCell>
